{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kisa.dev/protocol/v0.1/core/entity.schema.json",
  "title": "KISA Entity",
  "type": "object",
  "required": [
    "kisaVersion",
    "id",
    "entityType",
    "createdAt",
    "contentDigest",
    "producer"
  ],
  "properties": {
    "kisaVersion": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "entityType": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "contentDigest": {
      "type": "object",
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "activityId": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "CLEAN",
        "TAINTED",
        "INVALIDATED"
      ]
    },
    "data": {
      "type": "object"
    }
  },
  "additionalProperties": true
}